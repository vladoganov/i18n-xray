{
  "name": "i18n-xray",
  "version": "1.0.0",
  "description": "See how your React app actually uses translations: dead keys, duplicated values, locale gaps. One CLI, one offline HTML report.",
  "keywords": [
    "i18n",
    "i18next",
    "react",
    "static-analysis",
    "cli",
    "translations",
    "localization"
  ],
  "homepage": "https://github.com/vladoganov/i18n-xray#readme",
  "bugs": {
    "url": "https://github.com/vladoganov/i18n-xray/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladoganov/i18n-xray.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Vlad Oganov",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "i18n-xray": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node -e \"const fs=require('fs');for(const f of ['README.md','LICENSE'])fs.copyFileSync('../../'+f,f)\""
  },
  "dependencies": {
    "commander": "catalog:",
    "fast-glob": "catalog:"
  },
  "devDependencies": {
    "@i18n-xray/contracts": "workspace:*",
    "@i18n-xray/core": "workspace:*",
    "@i18n-xray/loader": "workspace:*",
    "@i18n-xray/scanner": "workspace:*",
    "@i18n-xray/viewer": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
